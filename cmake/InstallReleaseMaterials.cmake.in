set(S100_XMLLINT "@XM_LLINT_EXECUTABLE@")
set(S100_DEPENDENCY_BIN "@VCPKG_INSTALLED_DIR@/@VCPKG_TARGET_TRIPLET@/bin")
set(S100_DESTINATION "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/bin")
set(S100_DUMPBIN "@DUMPBIN_EXECUTABLE@")
include("@CMAKE_SOURCE_DIR@/cmake/DeployXmlLint.cmake")

if(NOT EXISTS "@S100_SOURCE_BUNDLE@" OR NOT EXISTS "@S100_SOURCE_BUNDLE@.manifest.json")
  message(FATAL_ERROR "Prepare corresponding sources with tools/package_sources.py and configure S100_SOURCE_BUNDLE before packaging.")
endif()
file(READ "@S100_SOURCE_BUNDLE@.manifest.json" _manifest)
string(JSON _source_hash GET "${_manifest}" archive_sha256)
file(SHA256 "@S100_SOURCE_BUNDLE@" _actual_hash)
if(NOT _source_hash STREQUAL _actual_hash)
  message(FATAL_ERROR "Corresponding-source archive changed after its manifest was generated")
endif()
file(INSTALL "@S100_SOURCE_BUNDLE@" DESTINATION "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/sources" RENAME corresponding-sources.zip)
file(INSTALL "@S100_SOURCE_BUNDLE@.manifest.json" DESTINATION "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/sources" RENAME manifest.json)

file(GLOB _port_records "@VCPKG_INSTALLED_DIR@/@VCPKG_TARGET_TRIPLET@/share/*/vcpkg.spdx.json")
if(NOT _port_records)
  message(FATAL_ERROR "Windows packaging requires vcpkg dependency records and copyright files")
endif()
foreach(_record IN LISTS _port_records)
  get_filename_component(_port_directory "${_record}" DIRECTORY)
  get_filename_component(_port "${_port_directory}" NAME)
  if(NOT EXISTS "${_port_directory}/copyright")
    message(FATAL_ERROR "Missing third-party copyright notice: ${_port}")
  endif()
  file(READ "${_record}" _record_json)
  unset(_name)
  string(JSON _count LENGTH "${_record_json}" packages)
  math(EXPR _last "${_count} - 1")
  foreach(_index RANGE 0 ${_last})
    string(JSON _id GET "${_record_json}" packages ${_index} SPDXID)
    if(_id STREQUAL "SPDXRef-port")
      string(JSON _name GET "${_record_json}" packages ${_index} name)
    endif()
  endforeach()
  if(NOT DEFINED _name)
    message(FATAL_ERROR "Missing port identity in dependency record: ${_port}")
  endif()
  file(SHA256 "${_record}" _record_hash)
  string(JSON _expected_hash ERROR_VARIABLE _missing GET "${_manifest}" ports "${_name}" spdx_sha256)
  if(_missing OR NOT _expected_hash STREQUAL _record_hash)
    message(FATAL_ERROR "Corresponding sources do not match installed dependency: ${_name}")
  endif()
  file(INSTALL "${_port_directory}/copyright" "${_record}"
    DESTINATION "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/licenses/${_port}")
endforeach()
